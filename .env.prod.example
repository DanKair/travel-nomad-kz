# --- DATABASE (Production) ---
POSTGRES_USER=''
POSTGRES_PASSWORD=''
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=''

# --- REDIS ---
REDIS_URL=redis://redis:6379/0

# --- APPLICATION ---
APP_NAME="Travel Nomad KZ"
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=generate_a_long_random_string_here
TEAM_API_KEY=some_long_secure_api_key
ENABLE_ADMIN=false
ALLOWED_ADMIN_IPS=localhost # Replace with your VPS/Home IP

# --- CORS ---
# In production, restrict this to your domain!
ALLOWED_ORIGINS=["https://yourdomain.kz","https://www.yourdomain.kz"]

# --- ROUTING WEIGHTS ---
DEFAULT_TIME_WEIGHT=0.4
DEFAULT_COST_WEIGHT=0.3
DEFAULT_COMFORT_WEIGHT=0.2
DEFAULT_CO2_WEIGHT=0.1
