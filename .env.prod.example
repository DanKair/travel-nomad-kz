# TRAVEL NOMAD KZ - PRODUCTION ENVIRONMENT
# Copy this to .env on your VPS

# Database (PostgreSQL) - Set these to strong random values
POSTGRES_USER=''
POSTGRES_PASSWORD=''
POSTGRES_DB=''
POSTGRES_SERVER=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Application
APP_NAME="Nomad Travel KZ"
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=generate_a_long_random_string_for_sessions

# Security
TEAM_API_KEY=generate_a_strong_api_key_for_your_team
ALLOWED_ADMIN_IPS=your_vps_ip,your_home_ip

# CORS — allowed frontend origins (JSON list)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:80"]

# Routing Algorithm Default Weights
DEFAULT_TIME_WEIGHT=0.4
DEFAULT_COST_WEIGHT=0.3
DEFAULT_COMFORT_WEIGHT=0.2
DEFAULT_CO2_WEIGHT=0.1
