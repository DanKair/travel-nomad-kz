# TRAVEL NOMAD KZ - DEVELOPMENT ENVIRONMENT
# Copy this to .env for local development


# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=''
POSTGRES_DB=''
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Application
APP_NAME="Nomad Travel KZ (DEV)"
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=dev_secret_key_change_me_in_prod

# Security
TEAM_API_KEY=dev_team_key
ALLOWED_ADMIN_IPS=127.0.0.1,localhost

# CORS — allowed frontend origins (JSON list)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:80"]

# Routing Algorithm Default Weights
DEFAULT_TIME_WEIGHT=0.4
DEFAULT_COST_WEIGHT=0.3
DEFAULT_COMFORT_WEIGHT=0.2
DEFAULT_CO2_WEIGHT=0.1
