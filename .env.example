# Environment Configuration Example
# Copy this file to .env and adjust values as needed

# Database
# For Sqlite use:
# DATABASE_URL=sqlite:///./nomad_travel.db

# For PostgreSQL, use: postgresql://user:password@localhost/dbname
POSTGRES_USER=
POSTGRES_PASSWORD=''
POSTGRES_DB=''

# Application
APP_NAME=NomadTravelKZ
APP_VERSION=1.0.0
DEBUG=true

# Routing Algorithm Default Weights (must sum to 1.0)
DEFAULT_TIME_WEIGHT=0.4
DEFAULT_COST_WEIGHT=0.3
DEFAULT_COMFORT_WEIGHT=0.2
DEFAULT_CO2_WEIGHT=0.1
