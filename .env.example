# TRAVEL NOMAD KZ - DEVELOPMENT ENVIRONMENT
# Copy this to .env for local development


# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=''
POSTGRES_DB=''
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Application
APP_NAME="Nomad Travel KZ (DEV)"
APP_VERSION=1.0.0

# Security
SECRET_KEY=dev_secret_key_change_me_in_prod
TEAM_API_KEY=dev_team_key_change_me
ENABLE_ADMIN=true
ALLOWED_ADMIN_IPS=127.0.0.1,localhost

# CORS — allowed frontend origins (JSON list)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:80"]

# Routing Algorithm Default Weights
DEFAULT_TIME_WEIGHT=0.4
DEFAULT_COST_WEIGHT=0.3
DEFAULT_COMFORT_WEIGHT=0.2
DEFAULT_CO2_WEIGHT=0.1

# --- GEO SERVICES ---
# Road distances/durations. The public demo server is rate-limited with no SLA;
# point this at a self-hosted OSRM (Kazakhstan extract) for real use.
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# --- PROXY TRUST ---
# Number of reverse proxies YOU run in front of the app. Only that many
# right-most X-Forwarded-For entries are trusted for the admin IP allowlist.
# 1 = the bundled frontend nginx. Use 2 if an extra nginx sits in front of it.
TRUSTED_PROXY_COUNT=1
